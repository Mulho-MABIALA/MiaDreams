{
  "name": "Leads - Restaurants sans site web à Lyon",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup rapide\n1. Colle ta clé Google Places API dans le nœud \"Rechercher restaurants\" (header X-Goog-Api-Key)\n2. Connecte ton compte Google Sheets dans le nœud \"Ajouter à la feuille de leads\"\n3. Colle l'ID de ta Google Sheet dans ce même nœud\n4. Teste avec le bouton \"Execute Workflow\" avant d'activer le trigger\n\nVoir le guide fourni pour le détail de chaque étape.",
        "height": 260,
        "width": 320
      },
      "id": "sticky-setup",
      "name": "Notes de setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [220, 40]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Chaque lundi 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Goog-Api-Key", "value": "COLLE_TA_CLE_API_ICI" },
            { "name": "X-Goog-FieldMask", "value": "places.id,places.displayName,places.formattedAddress,places.websiteUri,places.rating,places.userRatingCount,places.internationalPhoneNumber,places.googleMapsUri" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"textQuery\": \"restaurants à Lyon\",\n  \"languageCode\": \"fr\",\n  \"maxResultCount\": 20\n}",
        "options": {}
      },
      "id": "http-places-search",
      "name": "Rechercher restaurants (Google Places)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 340]
    },
    {
      "parameters": {
        "fieldToSplitOut": "places",
        "options": {}
      },
      "id": "split-places",
      "name": "Séparer chaque établissement",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [700, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "cond-no-website",
              "leftValue": "={{ $json.websiteUri }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty", "singleValue": true }
            },
            {
              "id": "cond-low-rating",
              "leftValue": "={{ $json.rating }}",
              "rightValue": 3.5,
              "operator": { "type": "number", "operation": "lt" }
            }
          ]
        },
        "options": {}
      },
      "id": "filter-opportunites",
      "name": "Filtrer (pas de site ou mauvaise note)",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [940, 340]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "nom", "type": "string", "value": "={{ $json.displayName?.text }}" },
            { "id": "f2", "name": "adresse", "type": "string", "value": "={{ $json.formattedAddress }}" },
            { "id": "f3", "name": "telephone", "type": "string", "value": "={{ $json.internationalPhoneNumber }}" },
            { "id": "f4", "name": "note_google", "type": "number", "value": "={{ $json.rating }}" },
            { "id": "f5", "name": "nb_avis", "type": "number", "value": "={{ $json.userRatingCount }}" },
            { "id": "f6", "name": "a_un_site_web", "type": "boolean", "value": "={{ !!$json.websiteUri }}" },
            { "id": "f7", "name": "lien_google_maps", "type": "string", "value": "={{ $json.googleMapsUri }}" },
            { "id": "f8", "name": "date_collecte", "type": "string", "value": "={{ $now.toISODate() }}" }
          ]
        },
        "options": {}
      },
      "id": "shape-lead",
      "name": "Mettre en forme le lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1180, 340]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "COLLE_ICI_L_ID_DE_TA_GOOGLE_SHEET",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "google-sheets-append",
      "name": "Ajouter à la feuille de leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1420, 340],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REMPLACE_PAR_TON_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Chaque lundi 8h": {
      "main": [[{ "node": "Rechercher restaurants (Google Places)", "type": "main", "index": 0 }]]
    },
    "Rechercher restaurants (Google Places)": {
      "main": [[{ "node": "Séparer chaque établissement", "type": "main", "index": 0 }]]
    },
    "Séparer chaque établissement": {
      "main": [[{ "node": "Filtrer (pas de site ou mauvaise note)", "type": "main", "index": 0 }]]
    },
    "Filtrer (pas de site ou mauvaise note)": {
      "main": [[{ "node": "Mettre en forme le lead", "type": "main", "index": 0 }]]
    },
    "Mettre en forme le lead": {
      "main": [[{ "node": "Ajouter à la feuille de leads", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "leads-restaurants-lyon-v1"
  }
}
